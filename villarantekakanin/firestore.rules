rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      // Public orders are accepted only through the callable Cloud Function.
      // Admin SDK writes from the function bypass these client rules.
      allow create: if false;
    }

    match /productSettings/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{privateCollection}/{document=**} {
      allow read, write: if false;
    }
  }
}
