PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Must be at least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Omit AUTH_DB_PATH to use the default database outside the site folder.
# AUTH_DB_PATH=
# Owner account email; the signed-in account email must match exactly.
ADMIN_EMAIL=owner@example.com
# Apps Script web app URL used by the protected admin API.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Generate a random value with the SESSION_SECRET command above. Set it in
# .env and Apps Script Script Properties as ADMIN_API_SECRET.
APPS_SCRIPT_ADMIN_SECRET=replace-with-a-random-admin-secret-at-least-32-characters-long
# Set to 1 only when the Node app is behind one trusted reverse proxy.
TRUST_PROXY=0
